DATABASE_URL=postgresql://qassemiya:qassemiya@localhost:5432/qassemiya_pos
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
PORT=3000
# 32-byte hex key for AES-256-GCM encryption of the Shopify access token at
# rest. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SHOPIFY_TOKEN_ENC_KEY=change-me-64-hex-chars
# Same idea, independent key, for the WhatsApp access token.
WHATSAPP_TOKEN_ENC_KEY=change-me-64-hex-chars
# Same idea, independent key, for the Tamara API key.
TAMARA_TOKEN_ENC_KEY=change-me-64-hex-chars
# Same idea, independent key, for the Tabby secret key.
TABBY_TOKEN_ENC_KEY=change-me-64-hex-chars
# Public base URL customers' browsers can reach — used to build the invoice
# link sent via WhatsApp (GET {PUBLIC_BASE_URL}/invoices/:orderId). Must be
# a real internet-reachable URL in production, not localhost.
PUBLIC_BASE_URL=http://localhost:3000
